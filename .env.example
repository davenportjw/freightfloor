# ============================================================================
# AI Warehouse — Local & Cloud Environment Variables Template
# Copy to `.env` for local overrides (`.env` is gitignored and dockerignored).
# Authentication to Google Cloud uses Application Default Credentials (ADC):
#   gcloud auth application-default login
# Never use or commit raw API keys or service account JSON files.
# ============================================================================

# Google Cloud Project & Region (Vertex AI + Firestore + Pub/Sub + Model Armor)
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=global

# Vertex AI Model (must be in ALLOWED_GEMINI_MODELS: gemini-3.5-flash-lite, gemini-3.8-flash, etc.)
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional Model Armor template resource name for remote prompt/response screening
# MODEL_ARMOR_TEMPLATE=projects/your-gcp-project-id/locations/us-central1/templates/warehouse-prompt-armor

# Shared HMAC-SHA256 secret for join tickets and lobby-to-site proxy headers (min 16 chars)
# In Cloud Run, injected via Secret Manager (TICKET_HMAC_SECRET_NAME or secret_key_ref)
TICKET_SECRET=replace-with-random-32-byte-hex-secret

# Site Engine Configuration (used when running apps/site directly)
SITE_ID=den-1
HOST=127.0.0.1
PORT=8081
# Set REQUIRE_PROXY_AUTH=1 locally to enforce x-warehouse-proxy header verification (always enabled in Cloud Run)
# REQUIRE_PROXY_AUTH=1

# Lobby Frontend Gateway Configuration (used when running apps/lobby)
# Maps site IDs to internal backend site HTTP origins for WebSocket & wake proxying
SITE_URLS_JSON={"den-1":"http://127.0.0.1:8081","slc-2":"http://127.0.0.1:8082","phx-3":"http://127.0.0.1:8083","abq-4":"http://127.0.0.1:8084"}
RATE_LIMIT_PER_MIN=30
