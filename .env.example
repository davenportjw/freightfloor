# ============================================================================
# Freight Floor — Local & Cloud Environment Variables Template
# Copy to `.env` for local overrides (`.env` is gitignored, dockerignored, and gcloudignored).
#
# Authentication to Google Cloud uses Application Default Credentials (ADC):
#   gcloud auth application-default login
# Never use or commit raw API keys or service account JSON files.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Shared Security & HMAC Ticket Signing (Lobby <-> Site)
# ----------------------------------------------------------------------------
# Shared HMAC-SHA256 secret (min 32 chars recommended) used to sign:
#   - 60-second single-use join tickets (`warehouse-join-ticket-v1:`)
#   - Lobby-to-Site WebSocket reverse proxy headers (`x-warehouse-proxy`)
#   - Privacy-preserving public leaderboard driver IDs (`publicIdFor`)
# In Cloud Run, injected automatically from Google Cloud Secret Manager (`ticket-hmac-key`).
# Locally, set the same value in both `apps/site` and `apps/lobby`:
TICKET_SECRET=replace-with-random-32-byte-hex-secret
# Alias accepted by both lobby and site:
# TICKET_HMAC_SECRET=replace-with-random-32-byte-hex-secret
# Optional Secret Manager secret resource name when fetching via Secret Manager API:
# TICKET_HMAC_SECRET_NAME=projects/your-gcp-project-id/secrets/ticket-hmac-key/versions/latest

# ----------------------------------------------------------------------------
# 2. Google Cloud Project, Vertex AI & Model Armor
# ----------------------------------------------------------------------------
GCP_PROJECT_ID=your-gcp-project-id
# Optional alias: GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Vertex AI Gemini model & location for autonomous shift brains and Dispatcher's Call
# Allowed models: gemini-3.5-flash-lite, gemini-3.8-flash, gemini-4-argon
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_LOCATION=global

# Optional Google Cloud Model Armor template for Layer-2/Layer-5 prompt & response screening
# MODEL_ARMOR_LOCATION=us-central1
# MODEL_ARMOR_TEMPLATE=projects/your-gcp-project-id/locations/us-central1/templates/warehouse-orders

# ----------------------------------------------------------------------------
# 3. Cloud Persistence (Firestore & Pub/Sub)
# ----------------------------------------------------------------------------
# Local processes default to in-memory persistence unless USE_CLOUD_PERSISTENCE=1 (or K_SERVICE is set)
# USE_CLOUD_PERSISTENCE=0
FIRESTORE_DATABASE_ID=(default)
# Optional environment suffix ("" for prod, "-stg" for staging)
SUFFIX=
# Optional Pub/Sub topic for cross-site pallet transfers (`-> network`)
# TRANSFERS_TOPIC=site-transfers
# Service account email verified on incoming `/internal/transfer` Pub/Sub push OIDC tokens:
# PUBSUB_PUSH_SERVICE_ACCOUNT=warehouse-pubsub-push@your-gcp-project-id.iam.gserviceaccount.com

# ----------------------------------------------------------------------------
# 4. Regional Site Engine (`apps/site`)
# ----------------------------------------------------------------------------
# Regional facility ID: den-1 | slc-2 | phx-3 | abq-4
SITE_ID=den-1
HOST=127.0.0.1
PORT=8081

# Number of autonomous AI forklifts on the floor (default: 20 on den-1, 12 on overflow shards)
AGENTS=20

# Idle scaling policy when 0 humans are connected:
#   break = pause simulation & AI brain calls after 5 min idle (scale-to-zero friendly)
#   run   = keep simulation ticking continuously
IDLE_POLICY=break

# Enforce x-warehouse-proxy header verification on `/ws` and internal routes (always "1" in Cloud Run)
# REQUIRE_PROXY_AUTH=0

# Gameplay feature flags ("1" = enabled, "0" = disabled)
ENABLE_DISPATCHERS_CALL=1
ENABLE_RACK_LIFT_MINIGAME=0

# ----------------------------------------------------------------------------
# 5. Public Lobby Gateway (`apps/lobby`)
# ----------------------------------------------------------------------------
# When running apps/lobby, set PORT=8080 (or desired gateway port) and map site IDs to site HTTP origins:
SITE_URLS_JSON={"den-1":"http://127.0.0.1:8081","slc-2":"http://127.0.0.1:8082","phx-3":"http://127.0.0.1:8083","abq-4":"http://127.0.0.1:8084"}

# Per-IP API rate limit (requests per minute on /api/join and /api/queue*)
RATE_LIMIT_PER_MIN=60
MAX_WAREHOUSES=8
QUEUE_SCALE_THRESHOLD=8

# ----------------------------------------------------------------------------
# 6. Smoke & Load Test Harnesses (`tools/smoke`, `tools/loadtest`)
# ----------------------------------------------------------------------------
# Target lobby URL for `npm run smoke:live`, `npm run smoke:armor`, `npm run smoke:ui`, or `tools/loadtest`
# LOBBY_URL=http://127.0.0.1:8080
# PROTOCOL_BOTS=112
# PILOT_AGENTS=16
# PILOT_BUDGET_USD=1.5
