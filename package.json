{
  "name": "warehouse",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "build": "wireit",
    "typecheck": "npm run build && npx tsc --noEmit -p tools/ast-sidecar/tsconfig.json",
    "test": "wireit",
    "test:sim": "npm test -w @warehouse/sim",
    "test:protocol": "npm test -w @warehouse/protocol",
    "test:armor": "npm test -w @warehouse/armor",
    "test:site": "npm test -w @warehouse/site",
    "test:lobby": "npm test -w @warehouse/lobby",
    "test:ast": "npm test -w @warehouse/ast-sidecar",
    "ast:sync": "node --no-warnings tools/ast-sidecar/dist/cli.js sync",
    "ast:query": "node --no-warnings tools/ast-sidecar/dist/cli.js",
    "ast:analyze": "node --no-warnings tools/ast-sidecar/dist/cli.js analyze",
    "ast:benchmark": "node --no-warnings tools/ast-sidecar/dist/cli.js benchmark",
    "ast:export": "node --no-warnings tools/ast-sidecar/dist/cli.js export",
    "report:retention": "npm run build -w @warehouse/smoke && node tools/smoke/dist/retention.js",
    "changelog:draft": "node scripts/changelog-draft.mjs"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "./packages/protocol:build",
        "./packages/armor:build",
        "./packages/sim:build",
        "./apps/client:build",
        "./apps/lobby:build",
        "./apps/site:build",
        "./tools/loadtest:build",
        "./tools/smoke:build",
        "./tools/ast-sidecar:build"
      ]
    },
    "test": {
      "dependencies": [
        "./packages/protocol:test",
        "./packages/armor:test",
        "./packages/sim:test",
        "./apps/client:test",
        "./apps/lobby:test",
        "./apps/site:test",
        "./tools/loadtest:test",
        "./tools/smoke:test",
        "./tools/ast-sidecar:test"
      ]
    }
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/ws": "^8.5.14",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6",
    "wireit": "^0.14.13"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
