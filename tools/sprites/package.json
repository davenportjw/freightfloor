{
  "name": "@warehouse/sprites",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "wireit",
    "generate": "wireit",
    "test": "wireit"
  },
  "wireit": {
    "build": {
      "command": "tsc",
      "files": [
        "src/**",
        "tsconfig.json",
        "../../tsconfig.base.json"
      ],
      "output": [
        "dist/**"
      ],
      "clean": "if-file-deleted"
    },
    "generate": {
      "dependencies": [
        "../../:sprites"
      ]
    },
    "test": {
      "command": "vitest run",
      "dependencies": [
        "build"
      ],
      "files": [
        "test/**",
        "src/**",
        "tsconfig.json"
      ],
      "output": []
    }
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.68"
  }
}
