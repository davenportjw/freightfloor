{
  "name": "@warehouse/smoke",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "wireit",
    "test": "wireit"
  },
  "wireit": {
    "build": {
      "command": "tsc",
      "dependencies": [
        "../../packages/protocol:build"
      ],
      "files": [
        "src/**",
        "tsconfig.json",
        "../../tsconfig.base.json"
      ],
      "output": [
        "dist/**"
      ],
      "clean": "if-file-deleted"
    },
    "test": {
      "command": "vitest run",
      "dependencies": [
        "build",
        "../../packages/armor:build",
        "../../apps/lobby:build",
        "../../apps/site:build"
      ],
      "files": [
        "test/**",
        "src/**",
        "tsconfig.json"
      ],
      "output": []
    }
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.11.0",
    "@google-cloud/secret-manager": "^5.6.0",
    "@warehouse/protocol": "*",
    "google-auth-library": "^9.15.1",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@warehouse/armor": "*",
    "@warehouse/lobby": "*",
    "@warehouse/site": "*",
    "playwright-core": "^1.64.1"
  }
}
