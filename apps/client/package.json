{
  "name": "@warehouse/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "wireit",
    "preview": "vite preview",
    "typecheck": "wireit",
    "test": "wireit"
  },
  "wireit": {
    "build": {
      "command": "vite build",
      "dependencies": [
        "../../packages/armor:build",
        "../../packages/protocol:build",
        "../../packages/sim:build",
        "../../:sprites"
      ],
      "files": [
        "src/**",
        "public/**",
        "index.html",
        "vite.config.ts",
        "tsconfig.json"
      ],
      "output": [
        "dist/**"
      ],
      "clean": "if-file-deleted"
    },
    "typecheck": {
      "command": "tsc --noEmit -p .",
      "dependencies": [
        "../../packages/armor:build",
        "../../packages/protocol:build",
        "../../packages/sim:build"
      ],
      "files": [
        "src/**",
        "tsconfig.json",
        "../../tsconfig.base.json"
      ],
      "output": []
    },
    "test": {
      "command": "vitest run",
      "dependencies": [
        "../../packages/armor:build",
        "../../packages/protocol:build",
        "../../packages/sim:build",
        "typecheck"
      ],
      "files": [
        "test/**",
        "src/**",
        "tsconfig.json"
      ],
      "output": []
    }
  },
  "dependencies": {
    "@warehouse/armor": "*",
    "@warehouse/protocol": "*",
    "@warehouse/sim": "*",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.7",
    "tailwindcss": "^4.0.7",
    "vite": "^6.1.1"
  }
}
